{
  "name": "turf-cricket-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first live cricket scoring for turf matches. Static web app, no build step.",
  "type": "commonjs",
  "scripts": {
    "test": "node tests/engine.test.js",
    "start": "python -m http.server 8090",
    "test:rules": "firebase emulators:exec --only firestore --project demo-turf-cricket \"node --test tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-turf-cricket"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
